{
  "name": "refract",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @refract/tauri-poc dev",
    "build": "pnpm --filter @refract/tauri-poc build",
    "lint": "eslint apps/renderer/src/renderer apps/renderer/tests apps/tauri/*.ts packages --ext .ts,.tsx",
    "check:contracts": "node scripts/check-contracts.mjs",
    "i18n:help": "lexmit help",
    "i18n:status": "lexmit status",
    "i18n:check": "lexmit check",
    "i18n:missing": "lexmit missing",
    "i18n:create": "lexmit create",
    "i18n:fill": "lexmit fill",
    "i18n:translate": "lexmit translate",
    "i18n:review": "lexmit review",
    "i18n:sync": "lexmit sync",
    "i18n:verify": "lexmit verify",
    "i18n:verify-staged": "lexmit verify --staged",
    "i18n:presentation-check": "lexmit presentation --check",
    "i18n:presentation-write": "lexmit presentation --write",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@shulha/lexmit": "^0.1.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
